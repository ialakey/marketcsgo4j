# A market.csgo.com API key spends real money and cannot be revoked without
# issuing a new one, so it belongs in the environment and never in the repo.
# Create keys at https://market.csgo.com/en/api

MARKET_CSGO_KEY_MAIN=
MARKET_CSGO_KEY_SPARE=

# Optional. The client defaults to https://market.csgo.com
# MARKET_CSGO_BASE_URL=https://market.csgo.com
