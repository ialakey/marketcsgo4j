# Normalise line endings so a checkout on Windows and one on Linux produce the
# same bytes, and the CI matrix does not fail on whitespace.
* text=auto eol=lf

*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.md     text eol=lf
*.imports text eol=lf

*.jar    binary
*.png    binary
*.zip    binary
